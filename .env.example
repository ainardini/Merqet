DATABASE_URL="postgresql://user:password@host:5432/campus_trade?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"

# For sending verification code emails via Resend (resend.com).
# Without these, codes are just printed to your server console, which is fine
# for local development but won't work in production.
RESEND_API_KEY=""
EMAIL_FROM="Merqet <onboarding@resend.dev>"

# For photo uploads via Vercel Blob. If you add Vercel Blob storage to your
# project (Storage tab in the Vercel dashboard, same way we added Postgres),
# this gets set automatically — no need to fill it in by hand.
BLOB_READ_WRITE_TOKEN=""
