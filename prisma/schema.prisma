// Campus Trade database schema.
// Uses Postgres so this works out of the box on Vercel (which has no
// persistent disk for SQLite). Get a free Postgres database from Neon,
// Supabase, or Railway and set DATABASE_URL to its connection string —
// same URL works for local dev and for your Vercel deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  campus        String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  listings              Listing[]
  offers                Offer[]
  sentMessages          Message[]
  conversationsAsBuyer  Conversation[]     @relation("BuyerConversations")
  conversationReads     ConversationRead[]
  verificationCodes     VerificationCode[]
  favorites             Favorite[]
  reviewsGiven          Review[]           @relation("ReviewsGiven")
  reviewsReceived       Review[]           @relation("ReviewsReceived")
  reportsFiled          Report[]           @relation("ReportsFiled")
  reportsReceived       Report[]           @relation("ReportsReceived")
  blocksMade            Block[]            @relation("BlocksMade")
  blocksReceived        Block[]            @relation("BlocksReceived")
}

// Short-lived one-time codes emailed to the user to verify they own the
// address they signed up with. codeHash is bcrypt-hashed like a password —
// codes are only 6 digits, but short expiry + attempt limits keep them safe.
model VerificationCode {
  id        String   @id @default(cuid())
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// available  -> open for offers
// reserved   -> an offer was accepted, buyer has OFFER_WINDOW_HOURS to confirm
// confirmed  -> buyer confirmed, meetup pending
// sold       -> completed
model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  condition   String
  price       Int // original asking price, in whole currency units
  currency    String   @default("MYR") // "MYR" or "KRW"
  meetupLocation String? // free-text spot the seller prefers to meet, e.g. "Library"
  emoji       String   @default("📦")
  photoUrl    String? // legacy single-photo field, kept for old listings created before multi-photo support
  photoUrls   String[] @default([]) // up to 5 photo URLs, uploaded via Vercel Blob; first one is the thumbnail
  viewCount   Int      @default(0) // raw pageview counter, excludes the seller's own visits
  status      String   @default("available")
  createdAt   DateTime @default(now())

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  offers        Offer[]
  conversations Conversation[]
  favoritedBy   Favorite[]
  reviews       Review[]
  reports       Report[]

  // Set when an offer is accepted; cleared when confirmed, cancelled, or expired.
  reservedOfferId String?
  reservedUntil   DateTime?
}

// pending   -> awaiting seller decision
// accepted  -> seller accepted; listing.status becomes "reserved"
// rejected  -> seller declined, or auto-declined because another offer was accepted
// confirmed -> buyer confirmed within the window
// expired   -> buyer missed the 48h window
model Offer {
  id        String   @id @default(cuid())
  amount    Int
  status    String   @default("pending")
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
}

// One conversation per (listing, buyer) pair — this is what actually scopes
// a chat. Without this, two different buyers messaging the same seller about
// the same listing would see each other's messages, which was the old bug.
model Conversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)

  messages Message[]
  reads    ConversationRead[]

  @@unique([listingId, buyerId])
}

model Message {
  id        String   @id @default(cuid())
  body      String? // optional now — a message can be just a photo or voice note
  createdAt DateTime @default(now())

  attachmentUrl  String? // uploaded via Vercel Blob, same as listing photos
  attachmentType String? // "image" or "audio"

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// Tracks the last time each participant (buyer or seller) read a
// conversation, so we can compute unread counts without storing per-message
// read flags for every participant.
model ConversationRead {
  id         String   @id @default(cuid())
  lastReadAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

// A buyer can review the seller once per listing, only after that listing
// actually sold to them (checked in the API, not enforceable at the schema
// level) — this keeps ratings tied to real completed transactions.
model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User   @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)

  revieweeId String
  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([listingId, reviewerId])
}

// status: "open" (default, needs review) | "dismissed" | "actioned"
// No admin UI is built for these yet — they're stored so you can query them
// directly in your database (or via Prisma Studio) until you build one.
model Report {
  id        String   @id @default(cuid())
  reason    String
  details   String?
  status    String   @default("open")
  createdAt DateTime @default(now())

  reporterId String
  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUserId String
  reportedUser   User   @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

// A one-directional block: when A blocks B, A stops seeing B's listings and
// neither can message or make offers to the other. B is not notified.
model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}
