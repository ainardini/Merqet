// Campus Trade database schema.
// Uses Postgres so this works out of the box on Vercel (which has no
// persistent disk for SQLite). Get a free Postgres database from Neon,
// Supabase, or Railway and set DATABASE_URL to its connection string —
// same URL works for local dev and for your Vercel deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  campus       String?
  createdAt    DateTime @default(now())

  listings Listing[]
  offers   Offer[]
  messages Message[]
}

// available  -> open for offers
// reserved   -> an offer was accepted, buyer has OFFER_WINDOW_HOURS to confirm
// confirmed  -> buyer confirmed, meetup pending
// sold       -> completed
model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  condition   String
  price       Int // original asking price, in whole currency units
  emoji       String   @default("📦")
  status      String   @default("available")
  createdAt   DateTime @default(now())

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  offers   Offer[]
  messages Message[]

  // Set when an offer is accepted; cleared when confirmed, cancelled, or expired.
  reservedOfferId String?
  reservedUntil   DateTime?
}

// pending   -> awaiting seller decision
// accepted  -> seller accepted; listing.status becomes "reserved"
// rejected  -> seller declined, or auto-declined because another offer was accepted
// confirmed -> buyer confirmed within the window
// expired   -> buyer missed the 48h window
model Offer {
  id        String   @id @default(cuid())
  amount    Int
  status    String   @default("pending")
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
